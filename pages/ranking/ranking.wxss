/* 热门排行页面样式优化 - 微信小程序兼容版 */
.container {
  padding: 30rpx;
  background: linear-gradient(180deg, #ff6b6b 0%, #feca57 50%, #ffa502 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #fff;
  border-radius: 44rpx;
  font-weight: 600;
}

.tab.active {
  background: #fff;
  color: #ff6b6b;
  font-weight: 800;
}

.ranking-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
  margin-right: 24rpx;
}

.rank-num.gold {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #fff;
}

.rank-num.silver {
  background: linear-gradient(135deg, #c0c0c0, #a0a0a0);
  color: #fff;
}

.rank-num.bronze {
  background: linear-gradient(135deg, #cd7f32, #b87333);
  color: #fff;
}

.rank-info {
  flex: 1;
}

.rank-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.rank-meaning {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 1.4;
}

.rank-hot {
  text-align: right;
  min-width: 100rpx;
}

.hot-num {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #ff6b6c;
}

.hot-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.update-time {
  text-align: center;
  margin-top: 36rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}