/* 名字对比页面样式优化 - 微信小程序兼容版 */
.container {
  padding: 40rpx;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.input-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.input-group {
  margin-bottom: 24rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.name-input {
  font-size: 40rpx;
  padding: 24rpx 30rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 16rpx;
  text-align: center;
  background: #f8f9fa;
}

.vs {
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #fa709a;
  margin: 24rpx 0;
}

.compare-btn {
  background: linear-gradient(135deg, #fa709a, #fee140);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  border-radius: 60rpx;
  padding: 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(250, 112, 154, 0.4);
}

.result-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
}

.winner {
  text-align: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  border-radius: 20rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
}

.winner-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.winner-name {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin: 16rpx 0;
}

.winner-reason {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.6;
}

.score-comparison {
  margin-bottom: 36rpx;
}

.score-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.score-name {
  width: 160rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.score-bar {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.score-fill {
  height: 100%;
  border-radius: 12rpx;
}

.score-fill.boy {
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.score-fill.girl {
  background: linear-gradient(90deg, #f093fb, #f5576c);
}

.score-value {
  width: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #666;
  text-align: right;
}

.share-btn {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 60rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}