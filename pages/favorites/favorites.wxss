/* 收藏页面样式优化 - 微信小程序兼容版 */
.container {
  padding: 40rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.result-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.name-item {
  background: linear-gradient(135deg, #fff5f8 0%, #fff 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #f0f0f0;
}

.name-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #f093fb, #f5576c);
}

.name-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #f5576c;
}

.delete-btn {
  color: #999;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
}

.name-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  font-weight: 600;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #bbb;
  margin-top: 16rpx;
}