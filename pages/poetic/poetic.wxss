/* 诗意取名页面样式优化 - 微信小程序兼容版 */
.container {
  padding: 40rpx;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.generate-btn {
  background: #fff;
  color: #11998e;
  font-size: 36rpx;
  font-weight: 800;
  border-radius: 60rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 153, 142, 0.3);
}

.result-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.name-item {
  background: linear-gradient(135deg, #f8fffa 0%, #fff 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #f0f0f0;
}

.name-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #11998e, #38ef7d);
}

.name-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #11998e;
}

.star {
  color: #ff9800;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.name-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.tips {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 30rpx;
}

.tips-title {
  display: block;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.tips-content {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 1.8;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}