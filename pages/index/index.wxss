/* 首页样式优化 - 微信小程序兼容版 */
.container {
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.input-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.surname-input {
  font-size: 40rpx;
  text-align: center;
  padding: 24rpx 30rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 16rpx;
  background: #f8f9fa;
}

.gender-section {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.gender-option {
  display: inline-flex;
  align-items: center;
  margin-right: 60rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.gender-option:last-child {
  margin-right: 0;
}

.generate-btn {
  background: linear-gradient(135deg, #ffd700 0%, #ffb800 100%);
  color: #333;
  font-size: 36rpx;
  font-weight: 800;
  border-radius: 60rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
}

.result-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.12);
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.name-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.name-item {
  background: linear-gradient(135deg, #f8f9ff 0%, #fff 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #f0f0f0;
}

.name-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
}

.name-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.name-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #667eea;
}

.score-row {
  display: flex;
  gap: 12rpx;
}

.score-badge {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.wuxing-badge {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.name-meaning {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.name-origin {
  display: block;
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

.share-btn {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 60rpx;
  margin-top: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.empty-state {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}